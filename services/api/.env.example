# Copy to .env and adjust.  All variables are optional.
# Parser: docling (strict, production) | pymupdf (no ML models) | auto (docling, fall back to pymupdf with a warning)
FINAUDIT_PARSER=docling
FINAUDIT_DATA_DIR=./data
FINAUDIT_MAX_UPLOAD_MB=100
FINAUDIT_MAX_PAGES=1500
# JSON list of allowed frontend origins (Vite dev server default port in this repo is 8080)
FINAUDIT_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
# Required before any deployment that is not bound to loopback. Unset for the local demo.
# FINAUDIT_API_TOKEN=
FINAUDIT_DOCLING_DO_OCR=false
FINAUDIT_DOCLING_PICTURE_CLASSIFICATION=false
FINAUDIT_DOCLING_NUM_THREADS=4
FINAUDIT_JOB_MAX_ATTEMPTS=3
FINAUDIT_JOB_STALE_AFTER_S=120
# Directory with pre-downloaded Docling weights (set in the Docker image); ignored if empty/missing
# FINAUDIT_DOCLING_ARTIFACTS_PATH=/opt/docling-models

# ---------------------------------------------------------------- retrieval (Milestone 3)
FINAUDIT_AUTO_INDEX=true
# onnx (default, local all-MiniLM-L6-v2; fetch with: python -m app.retrieval.fetch_models) | wordllama | openai | sentence-transformers | none
FINAUDIT_EMBEDDER=onnx
FINAUDIT_EMBEDDER_MODEL_PATH=./models/all-MiniLM-L6-v2
# For FINAUDIT_EMBEDDER=openai (any OpenAI-compatible /v1/embeddings endpoint):
# FINAUDIT_EMBEDDER_BASE_URL=http://localhost:11434/v1
# FINAUDIT_EMBEDDER_MODEL=nomic-embed-text
# FINAUDIT_EMBEDDER_API_KEY=...
# Qdrant server (required when API and worker run as separate processes); unset = embedded on-disk mode
# FINAUDIT_QDRANT_URL=http://localhost:6333
FINAUDIT_QA_METHOD=dense
FINAUDIT_QA_CHUNK_SET=layout
FINAUDIT_QA_TOP_K=8

# ---------------------------------------------------------------- LLM (QA + chart interpretation)
# none | anthropic | openai (OpenAI-compatible chat endpoint: OpenAI, vLLM, Ollama, LM Studio)
FINAUDIT_LLM_PROVIDER=none
# e.g. claude-opus-5-5 for anthropic; the model is configuration, never hard-coded
# FINAUDIT_LLM_MODEL=claude-opus-5-5
# The key is read server-side from the env var named here; never sent by clients.
FINAUDIT_LLM_API_KEY_ENV=FINAUDIT_LLM_API_KEY
# FINAUDIT_LLM_API_KEY=...
# FINAUDIT_LLM_BASE_URL=            # optional (required for provider=openai)
FINAUDIT_LLM_EFFORT=high
FINAUDIT_LLM_REFUSAL_FALLBACK=true
# Optional pricing for cost reporting (USD per 1M tokens); unset -> cost reported as null
# FINAUDIT_LLM_PRICE_INPUT_PER_MTOK=4
# FINAUDIT_LLM_PRICE_OUTPUT_PER_MTOK=20
