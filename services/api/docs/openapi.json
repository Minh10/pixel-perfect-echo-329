{
  "openapi": "3.1.0",
  "info": {
    "title": "FINAUDIT AI API",
    "description": "Financial PDF ingestion, layout-aware parsing and evidence provenance. No LLM auditing: all outputs are parser outputs with provenance.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Upload Document",
        "description": "Validate and store a PDF, then queue it for background processing (202 Accepted).\n\nMetadata fields are optional and stored exactly as supplied; nothing is inferred.  When no\ntitle is given we use the PDF's embedded title metadata, else the file name.",
        "operationId": "upload_document_api_v1_documents_post",
        "parameters": [
          {
            "name": "parser",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(docling|pymupdf|auto)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Parser"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_api_v1_documents_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "List Documents",
        "operationId": "list_documents_api_v1_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FinDocument"
                  },
                  "title": "Response List Documents Api V1 Documents Get"
                }
              }
            }
          }
        }
      }
    },
