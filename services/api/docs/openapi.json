  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError"
      },
      "BBox": {
        "properties": {
          "l": {
            "type": "number",
            "title": "L"
          },
          "t": {
            "type": "number",
            "title": "T"
          },
          "r": {
            "type": "number",
            "title": "R"
          },
          "b": {
            "type": "number",
            "title": "B"
          },
          "coordOrigin": {
            "type": "string",
            "const": "top-left",
            "title": "Coordorigin",
            "default": "top-left"
          },
          "unit": {
            "type": "string",
            "const": "pt",
            "title": "Unit",
            "default": "pt"
          }
        },
        "type": "object",
        "required": [
          "l",
          "t",
          "r",
          "b"
        ],
        "title": "BBox"
      },
      "Body_upload_document_api_v1_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PDF file"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "issuer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Issuer"
          },
          "period": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Annual Report",
                  "Quarterly Report",
                  "Prospectus",
                  "Sustainability Report"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_v1_documents_post"
      },
      "DocumentPage": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "section": {
            "type": "string",
            "title": "Section",
            "description": "Most recent heading text at or before this page; '' if none"
          },
          "width": {
            "type": "number",
            "title": "Width"
          },
          "height": {
            "type": "number",
            "title": "Height"
          },
          "rotation": {
            "type": "integer",
            "title": "Rotation"
          },
          "hasTextLayer": {
            "type": "boolean",
            "title": "Hastextlayer"
          },
          "charCount": {
            "type": "integer",
            "title": "Charcount"
          },
          "imageCount": {
            "type": "integer",
            "title": "Imagecount"
          },
          "confidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageConfidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "imageUrl": {
            "type": "string",
            "title": "Imageurl"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/PageBlock"
            },
            "type": "array",
            "title": "Blocks"
          }
        },
        "type": "object",
        "required": [
          "number",
          "section",
          "width",
          "height",
          "rotation",
          "hasTextLayer",
          "charCount",
          "imageCount",
          "imageUrl",
          "blocks"
        ],
        "title": "DocumentPage"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "blockId": {
            "type": "string",
            "title": "Blockid"
          },
          "category": {
            "type": "string",
            "enum": [
              "disclosure",
              "table",
              "figure"
            ],
            "title": "Category"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "extracted": {
            "type": "null",
            "title": "Extracted",
            "description": "Reserved: semantic field extraction is not implemented"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence",
            "description": "Parser-reported confidence if any; never invented"
          },
          "related": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Related"
          },
          "detection": {
            "$ref": "#/components/schemas/EvidenceDetection"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "type": "object",
        "required": [
          "id",
          "page",
          "blockId",
          "category",
          "label",
          "excerpt",
          "detection",
          "provenance"
        ],
        "title": "Evidence",
        "description": "An addressable, provenance-backed region.  It is *not* a verified financial fact."
      },
      "EvidenceDetection": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method"
          },
          "rule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule"
          }
        },
        "type": "object",
        "required": [
          "method"
        ],
        "title": "EvidenceDetection"
      },
      "FigureClassification": {
        "properties": {
          "className": {
            "type": "string",
            "title": "Classname"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "createdBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdby"
          }
        },
        "type": "object",
        "required": [
          "className"
        ],
        "title": "FigureClassification"
      },
      "FigureData": {
        "properties": {
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caption"
          },
          "classification": {
            "items": {
              "$ref": "#/components/schemas/FigureClassification"
            },
            "type": "array",
            "title": "Classification",
            "description": "Only populated when the Docling picture classifier is enabled"
